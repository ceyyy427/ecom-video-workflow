# Export these variables in your shell; .env is NOT automatically loaded.
# ECOM_DATA_DIR=/absolute/path/to/local-data
# ECOM_FONT=/absolute/path/to/NotoSansCJK-Regular.ttc
# Optional P1 model selection. Never put real credentials in version control.
# Only confirmed fact IDs/text are sent after explicit consent in the UI.
# Use a public HTTPS OpenAI-compatible endpoint ending in /v1 (no trailing /chat/completions).
# ECOM_LLM_BASE_URL=https://your-provider.example/v1
# ECOM_LLM_MODEL=your-model-name
# ECOM_LLM_API_KEY=your-secret
# No variables are needed for local extractive generation.

# P3 native platform writes: OFF by default. Configure OS credentials via scripts/qianchuan_setup.py.
# Only enable after app/account authorization and readiness for separately approved upload/create.
# ECOM_QIANCHUAN_WRITES=1

# P8 optional local-only Ollama vision. No API key; defaults to qwen3-vl:2b.
# Install explicitly: ollama pull qwen3-vl:2b
# ECOM_VISION_MODEL=qwen3-vl:2b
# 已验证本机模型自动启用驻留/前缀调度/内存保护；off 回退原执行方式。
# ECOM_VISION_ACCELERATION=auto

# P10: path only; use scripts/volc_voice_setup.py to enter API Key privately.
# ECOM_VOLC_VOICE_CONFIG=/absolute/path/to/private-volc-voice.json
# Or export DOUBAO_TTS_API_KEY privately in your shell (takes precedence over that file).
# Use a speech-console Key in the project with seed-tts-2.0 enabled; never commit a real Key.

# Verified small-Mac build: lazy private local process (auto); no cloud/model changes.
# ECOM_VISION_PROCESS=shared rolls back only scoped-process acceleration.
# ECOM_VISION_PROCESS=auto

# P13 local read-only Agent proposals: OFF by default; no executor or new provider calls.
# ECOM_AGENT_ENABLED=1

# P14 bounded local production: additionally opt in; all human gates stay manual.
# ECOM_AGENT_EXECUTION_ENABLED=1

# P15 explicit frozen review snapshots: OFF by default; no model calls or placement.
# ECOM_REVIEW_SNAPSHOTS_ENABLED=1

# P16 explicit human-selected iteration: OFF by default. Never auto-publishes.
# ECOM_EXPERIMENTS_ENABLED=1

# Optional offline final-film OCR (macOS Vision) and ASR. Never automatic approval.
ECOM_MEDIA_AUDIT=0
